<?xml version="1.0" encoding="utf-8"?>
<!--
    Material 3 ChatGPT account and chat settings page. Inflated by
    JugglucoChat with the Juggluco.M3.Light/Dark theme (see Menus.themed).
    The page is edge to edge; JugglucoChat pads jgc_panel by the system-bar,
    cutout and keyboard insets.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/jgc_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/jgc_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/jgchat_chatgpt"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/jgc_close"
            style="?attr/materialIconButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/jgchat_close"
            android:tooltipText="@string/jgchat_close"
            app:icon="@drawable/ic_jm_close" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/jgc_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Account -->
            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_jm_account_circle"
                            app:tint="?attr/colorPrimary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/jgc_account_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/jgc_account_detail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Signed out -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/jgc_sign_in"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:minHeight="56dp"
                        android:text="@string/jgchat_sign_in_with_chatgpt"
                        app:icon="@drawable/ic_jm_login"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/jgc_use_code"
                        style="?attr/borderlessButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/jgchat_use_a_code_instead" />

                    <!-- Waiting for the browser -->
                    <LinearLayout
                        android:id="@+id/jgc_browser_wait"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:indeterminate="true" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/jgchat_browser_sign_in_hint"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/jgc_reopen_browser"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/jgchat_open_sign_in_page_again"
                            app:icon="@drawable/ic_jm_open_in_new"
                            app:iconGravity="textStart" />
                    </LinearLayout>

                    <!-- Device code -->
                    <LinearLayout
                        android:id="@+id/jgc_code_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/jgchat_sign_in_code"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/jgc_code"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:textAppearance="?attr/textAppearanceHeadlineMedium"
                            android:textColor="?attr/colorOnSurface"
                            android:textIsSelectable="true" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/jgchat_native_open_the_sign_in_page_and_enter_the_code"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/jgc_copy_code"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:text="@string/jgchat_copy_code"
                                app:icon="@drawable/ic_jm_content_copy" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/jgc_open_page"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:text="@string/jgchat_open_sign_in_page"
                                app:icon="@drawable/ic_jm_open_in_new" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/jgc_login_link"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textIsSelectable="true" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/jgc_cancel_login"
                        style="?attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="@string/jgchat_cancel_sign_in" />

                    <!-- Signed in -->
                    <LinearLayout
                        android:id="@+id/jgc_signed_in_actions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/jgc_sign_out"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:text="@string/jgchat_sign_out"
                            app:icon="@drawable/ic_jm_logout" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/jgc_sign_in_again"
                            style="?attr/borderlessButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="@string/jgchat_sign_in_again" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/jgc_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/jgc_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:maxLines="4"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorError"
                        android:textIsSelectable="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Model -->
            <LinearLayout
                android:id="@+id/jgc_model_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Juggluco.M3.SectionHeader"
                    android:text="@string/jgchat_model" />

                <com.google.android.material.card.MaterialCardView
                    style="?attr/materialCardViewFilledStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/jgc_model"
                                style="@style/Juggluco.M3.Tile"
                                android:text="@string/jgchat_select_a_model"
                                app:icon="@drawable/ic_jm_smart_toy" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/jgc_reasoning"
                                style="@style/Juggluco.M3.Tile"
                                android:text="@string/jgchat_reasoning_server_default"
                                app:icon="@drawable/ic_jm_psychology" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/jgc_internet"
                            style="@style/Juggluco.M3.Switch"
                            android:paddingStart="16dp"
                            android:paddingEnd="12dp"
                            android:text="@string/jgchat_internet_search" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Chat -->
            <TextView
                style="@style/Juggluco.M3.SectionHeader"
                android:text="@string/jgchat_section_chat" />

            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/jgc_save_chat"
                            style="@style/Juggluco.M3.Tile"
                            android:text="@string/jgchat_save_chat_a8796cea"
                            app:icon="@drawable/ic_jm_save" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/jgc_share_chat"
                            style="@style/Juggluco.M3.Tile"
                            android:text="@string/jgchat_share_chat"
                            app:icon="@drawable/ic_jm_ios_share" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/jgc_saved_files"
                            style="@style/Juggluco.M3.Tile"
                            android:text="@string/jgchat_saved_files"
                            app:icon="@drawable/ic_jm_folder_open" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/jgc_new_chat"
                            style="@style/Juggluco.M3.Tile"
                            android:text="@string/jgchat_new_chat"
                            app:icon="@drawable/ic_jm_add_comment" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/jgc_clear_analysis"
                            style="@style/Juggluco.M3.Tile"
                            android:text="@string/jgchat_clear_analysis_memory"
                            app:icon="@drawable/ic_jm_delete_sweep" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/jgc_stop"
                            style="@style/Juggluco.M3.Tile"
                            android:text="@string/jgchat_stop_request"
                            app:icon="@drawable/ic_jm_stop_circle" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- App -->
            <TextView
                style="@style/Juggluco.M3.SectionHeader"
                android:text="@string/jm_section_app" />

            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/jgc_help"
                        style="@style/Juggluco.M3.Tile"
                        android:text="@string/helpname"
                        app:icon="@drawable/ic_jm_help" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/jgc_activity"
                        style="@style/Juggluco.M3.Tile"
                        android:text="@string/jgchat_activity"
                        app:icon="@drawable/ic_jm_history" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
