<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main-menu only: a horizontal wrap_content LinearLayout first measures
         its weighted children at their allotted widths, then remeasures
         match_parent-height children to the tallest child's height
         (LinearLayout.forceUniformHeight). No fixed pixel height or deferred
         layout listener: every width/font/content change measures afresh.

         Reserve two logical text lines even for short captions, but allow
         additional lines to grow the row instead of clipping/ellipsizing.
         Colours, icons, insets, widths and weights stay in the original styles. -->
    <style name="Juggluco.M3.MenuTile" parent="Juggluco.M3.Tile">
        <item name="android:layout_height">match_parent</item>
        <item name="android:minLines">2</item>
        <item name="android:maxLines">2147483647</item>
        <item name="android:ellipsize">@null</item>
    </style>

    <style name="Juggluco.M3.MenuTimeButton" parent="Juggluco.M3.TimeButton">
        <item name="android:layout_height">match_parent</item>
        <item name="android:minLines">2</item>
        <item name="android:maxLines">2147483647</item>
        <item name="android:ellipsize">@null</item>
    </style>
</resources>
